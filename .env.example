# Pooled Neon connection. The app reads DATABASE_URL, then POSTGRES_URL.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional direct connection used by npm run db:migrate and db:seed when set.
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Resend. RESEND_AUDIENCE_ID is the audience id, or a segment id on current Resend accounts.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Admin API: Authorization: Bearer <token>
ADMIN_TOKEN=

# Sponsor inquiry mail. Both receive the message when set.
OWNER_EMAIL=
BOT_EMAIL=
# Verified sender, for example hello@barterexchanges.org
FROM_EMAIL=hello@barterexchanges.org

# Canonical origin, no trailing slash.
SITE_URL=https://barterexchanges.org

# Google Analytics 4 measurement ID (optional; tag is omitted when unset)
NEXT_PUBLIC_GA_ID=
